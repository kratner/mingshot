{
  "name": "mingshot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "app": "sh scripts/build-app.sh",
    "test": "cd src-tauri && cargo test",
    "selftest": "cd src-tauri && cargo run --release --example selftest",
    "e2e": "sh scripts/e2e.sh",
    "bench": "MINGSHOT_BENCH=50 build/MingShot.app/Contents/MacOS/mingshot",
    "test:ui": "node src/geometry.test.ts && node src/scene.test.ts",
    "icons": "node scripts/icons.mjs",
    "test:editor": "vite build && node scripts/editor-ui-test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "konva": "^10.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "license": "MIT",
  "description": "Screen capture and markup: click New, grab any part of the screen."
}
